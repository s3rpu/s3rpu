# Copiar a .env y rellenar. NUNCA commitear el .env real.
# Generar los tres secretos con:  openssl rand -hex 32

# --- Dominios (deben apuntar por DNS a este servidor antes de arrancar) ---
BASEROW_HOST=panel.tudominio.es
N8N_HOST=flujos.tudominio.es
BASEROW_PUBLIC_URL=https://panel.tudominio.es

# --- Postgres ---
POSTGRES_USER=comunicacion
POSTGRES_PASSWORD=

# --- Secretos de aplicación ---
BASEROW_SECRET_KEY=
# Si se pierde, hay que reintroducir todas las credenciales guardadas en n8n.
N8N_ENCRYPTION_KEY=

# --- Opcional ---
# Poner a true cuando el gabinete ya tenga sus cuentas creadas.
BASEROW_DISABLE_SIGNUPS=false
